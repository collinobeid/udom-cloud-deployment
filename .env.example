# Udom Cloud Deployment - Environment Variables
# Copy this file to .env and change the passwords before running docker-compose up -d

MYSQL_ROOT_PASSWORD=udom_root_password_change_me
MYSQL_PASSWORD=udom_db_password_change_me
MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud

NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=udom_admin_password_change_me

# AppAPI HaRP Proxy shared key (for secure ExApp deployment)
APPAPI_SHARED_KEY=change_me_to_a_strong_random_key
