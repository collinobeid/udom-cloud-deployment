# Udom Cloud Deployment - Environment Variables Template
# Copy this file to .env and fill in real values before running docker-compose up -d
# NEVER commit the actual .env file - it's in .gitignore for a reason.

MYSQL_ROOT_PASSWORD=changeme
MYSQL_PASSWORD=changeme
MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud

NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=changeme

# AppAPI HaRP Proxy shared key (for secure ExApp deployment)
APPAPI_SHARED_KEY=changeme

# LDAP admin/agent bind password (used by ldap service and security-setup.sh)
LDAP_ADMIN_PASSWORD=changeme

# LDAP test-user passwords (Security domain - for security-init auto-repair)
LDAP_STUDENT_TEST_PASSWORD=changeme
LDAP_STAFF_TEST_PASSWORD=changeme
